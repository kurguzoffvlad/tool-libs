            ]
          }
        }
      }
    },
    "tool-exchange": {
      "projectType": "library",
      "root": "projects/tool-exchange",
      "sourceRoot": "projects/tool-exchange/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/tool-exchange/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/tool-exchange/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/tool-exchange/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
