            "tsConfig": "projects/tool-exchange/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "tool-width-page": {
      "projectType": "library",
      "root": "projects/tool-width-page",
      "sourceRoot": "projects/tool-width-page/src",
      "prefix": "lib",
      "architect": {
        "build": {
